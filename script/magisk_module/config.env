# Albatross 运行环境模块配置
#
# 修改方式（任选其一）：
#   1) 直接改本文件（重刷模块会被重置）
#   2) 复制到 /data/adb/albatross/config.env 再改（重刷模块不丢，优先级更高）
# 改完重启生效；也可以点模块的"操作"按钮立即重新配置。

# 开机自动拉起运行环境（安装核心、root 启动 albatross_server、让 Manager 连上）
AUTO_START=1

# 1=开机额外自动打开 AlbatrossManager 界面（部分 ROM 会拦后台启动 Activity）
LAUNCH_UI=0

# 自动安装/更新 AlbatrossManager APK（本模块不内置插件 APK，INSTALL_PLUGIN 保持 0）
INSTALL_MANAGER=1
INSTALL_PLUGIN=0

# 注入目标进程的运行选项（写入 Manager 的配置，只在配置变化时下发一次）
ENABLE_JIT=1             # 0=注入进程禁用 ART JIT（部分场景更稳）
ENABLE_ANTI_DETECTION=0  # 1=注入进程启用反检测
ENABLE_MEMFD_INJECT=0    # 1=用 memfd 内存注入（不落地文件）
ENABLE_KPM_HIDE=0        # 1=尝试内核级一键隐藏（需要 rwbp.ko，失败只记录日志）

# 若自行把插件 APK 放进模块并设 INSTALL_PLUGIN=1，这里填它的默认目标包（逗号分隔）
PLUGIN_TARGETS=

# 服务运行目录与监听地址
# ROOT_PATH 留空=沿用 Manager 配置（默认 /data/local/tmp/albatross/）
# SERVER_ADDRESS 留空=自动用「albatross_<设备序列号>」派生（面具装到哪台机器就哪台，避免撞名）；
#   以字母开头（纯数字会被服务端当成 TCP 端口），可用 字母/数字/._-；WebUI 里也能改
ROOT_PATH=
SERVER_ADDRESS=
SERVER_ADDRESS_AUTO=1

# 单条广播的等待秒数
BROADCAST_TIMEOUT=60

# ---- 启动自保护（防止本模块的启动把系统搞崩/反复重启）----
# 连续坏启动会逐级降级：① 关掉 内核隐藏/对抗/memfd ② 只装环境不启动服务 ③ 写 disable 自动禁用
# 恢复：管理器里重新启用模块，或 action.sh guard-reset / WebUI 的「复位保护」按钮
GUARD_ENABLE=1                 # 0=关闭所有保护判定
GUARD_MAX_BAD_BOOTS=3          # 连续坏启动达到几次就自动禁用
GUARD_EARLY_REBOOT_SECONDS=300 # 上次启动后多久内重启算"疑似启动导致"
GUARD_HEALTH_SECONDS=60        # 启动后的健康观察窗口（秒）
GUARD_DISABLE_ON_LIMIT=1       # 到限是否写 disable（0=最多降级到"只装不启"）
